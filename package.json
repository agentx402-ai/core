{
  "name": "@agentx402-ai/core",
  "version": "0.3.0",
  "description": "Shared auth/pay/usage/error/retry plumbing for agentx402 service SDKs (x402 + EIP-712 + EIP-3009 over viem).",
  "license": "MIT",
  "author": "The AgentKV Authors <contact@agentx402.ai>",
  "homepage": "https://github.com/agentx402-ai/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentx402-ai/core.git"
  },
  "bugs": {
    "url": "https://github.com/agentx402-ai/core/issues"
  },
  "keywords": [
    "agentx402",
    "x402",
    "eip-3009",
    "eip-712",
    "viem",
    "sdk-core"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "smoke": "node test/dist-smoke.mjs",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20.3"
  }
}
